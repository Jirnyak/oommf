xpdf begin
%%EndSetup
pdfStartPage
%%EndPageSetup
gsave
[373.2 0 0 169.2 0 0] concat
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Width 1555
  /Height 705
  /ImageMatrix [1555 0 0 -705 0 705]
  /BitsPerComponent 8
  /Decode [0 1 0 1 0 1]
  /DataSource currentfile
    /ASCII85Decode filter
    /LZWDecode filter
>>
