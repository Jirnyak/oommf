xpdf begin
%%EndSetup
pdfStartPage
%%EndPageSetup
gsave
[372 0 0 255.12 0 0] concat
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Width 1550
  /Height 1063
  /ImageMatrix [1550 0 0 -1063 0 1063]
  /BitsPerComponent 8
  /Decode [0 1 0 1 0 1]
  /DataSource currentfile
    /ASCII85Decode filter
    /LZWDecode filter
>>
