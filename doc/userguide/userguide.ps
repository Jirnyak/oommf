xpdf begin
%%EndSetup
pdfStartPage
%%EndPageSetup
[] 0 d
1 i
0 j
0 J
10 M
1 w
/DeviceGray {} cs
[0] sc
/DeviceGray {} CS
[0] SC
false op
false OP
{} settransfer
0 0 379.614 366.365 re
W
q
q
[379.614 0 0 366.365 0 0] cm
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Width 659
  /Height 636
  /ImageMatrix [659 0 0 -636 0 636]
  /BitsPerComponent 8
  /Decode [0 1 0 1 0 1]
  /DataSource currentfile
    /ASCII85Decode filter
    /LZWDecode filter
>>
